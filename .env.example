HOST=127.0.0.1
PORT=4100
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
DEMO_MODE=true
# Leave DATABASE_URL empty to run real PostgreSQL locally using PGlite.
# Production: supply a dedicated PostgreSQL database and use DEMO_MODE=false.
DATABASE_URL=
# Deployment migration jobs only; never give this credential to the web runtime.
MIGRATION_DATABASE_URL=
DATA_DIR=./data
# Required in production: a random value of at least 32 characters.
JWT_SECRET=
# Stable independent 32+ character key for encrypted staff authenticator secrets.
# Rotation needs a controlled re-encryption/re-enrollment procedure.
MFA_ENCRYPTION_KEY=
# Operator CLI only. Do not set this credential in the web process environment.
# STAFF_DATABASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Flingtopia <hello@your-domain.example>
# TLS uses normal certificate validation; provide your CA through NODE_EXTRA_CA_CERTS if needed.
DATABASE_SSL=false

# Hosted free staging: NODE_ENV=production, APP_ENV=staging, DEMO_MODE=false.
# Staging is protected by HTTP Basic Auth (username: staging).
APP_ENV=development
STAGING_ACCESS_PASSWORD=
# Explicitly expose staging without Basic Auth. Requires email enabled.
# Normal account authentication and authorization still apply.
STAGING_PUBLIC_ACCESS=false
# Explicit staging-only option. Does not verify accounts or bypass permissions.
STAGING_DISABLE_EMAIL=false
# Set to 1 only after checking the reverse proxy topology; default does not trust headers.
TRUST_PROXY_HOPS=0
# Resend HTTPS API takes precedence over SMTP; required on Render Free.
RESEND_API_KEY=
# Social sign-in providers appear only when their server credentials are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple uses the web Services ID and a Sign in with Apple signing key.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM contents with literal \\n line separators are supported.
APPLE_PRIVATE_KEY=
MEDIA_STORAGE=local
SUPABASE_URL=
# Server-only credential: never prefix with VITE_ or expose in client code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=flingtopia-photos-staging
